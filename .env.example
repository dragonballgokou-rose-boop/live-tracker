# Supabase 接続情報
# Supabase ダッシュボード > Settings > API からコピーしてください

# プロジェクト URL（例: https://xxxxxxxxxxxx.supabase.co）
VITE_SUPABASE_URL=your_supabase_project_url

# anon public キー
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Anthropic API キー（Claude API で画像解析を行う場合に必要）
# https://console.anthropic.com/settings/keys から取得
# 注意: フロントエンドから直接呼び出す場合はキーが公開されます。
#       本番環境では Supabase Edge Function 経由で呼び出すことを推奨します。
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key
