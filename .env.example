# Supabase 接続情報
# Supabase ダッシュボード > Settings > API からコピーしてください

# プロジェクト URL（例: https://xxxxxxxxxxxx.supabase.co）
VITE_SUPABASE_URL=your_supabase_project_url

# anon public キー
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================
# Web Push 通知（任意）
# ============================================
# VAPID 公開鍵（クライアントに埋め込まれる。公開して問題なし）
# 生成: node -e "…" （README 参照）または https://vapidkeys.com/
VITE_VAPID_PUBLIC_KEY=

# service-worker 用の push 宛先 URL（省略時は location.origin）
# PWA の場合は不要
